# 复制为 .env 后按需修改；docker compose 会自动读取 .env。
# 生产（gdk-ps）：容器只监听 127.0.0.1:9001，由主机 Nginx 反代并终止 HTTPS。
# 本地调试可改为 BIND_ADDR=0.0.0.0 让局域网访问。
HOST_PORT=9001
BIND_ADDR=127.0.0.1

# 镜像名与容器名
IMAGE_TAG=gift-pickup:local
CONTAINER_NAME=gift-pickup

# 上游订单域名，逗号或空格分隔；按顺序故障转移。
UPSTREAM_BASES=https://mm.qfmjh.cn

# 上游总超时预算（毫秒，1000–60000）。
UPSTREAM_TIMEOUT_MS=10000

# 站点对外地址，用于 canonical；无则留空。
PUBLIC_BASE_URL=

# 腾讯地图 URI 的 referer。
MAP_REFERER=188

# 1 = 允许 /api/gift?...&mock=1 演示数据；生产环境请设为 0。
MOCK=0

# 生产域名，空格或逗号分隔；deploy/apply-domain.sh 据此生成 Nginx vhost 并申请证书。
# 本地 docker compose --profile tls 时 Caddy 也读取该变量。
DOMAINS=gift.example.com
ACME_EMAIL=admin@example.com
