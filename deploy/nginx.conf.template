# gift-pickup H5（礼品提货）
# 由 deploy/apply-domain.sh 生成，请勿手工修改；改 .env 后重新执行该脚本。
#
# 上游：docker compose 的 gift 容器，发布在 127.0.0.1:9001
# 证书：acme.sh + Let's Encrypt（webroot /var/www/certbot），续期由 acme.sh cron 负责。
#
# 文件名以 zz- 开头：nginx 按字母序加载 vhost，首个 80 端口 server 成为默认站点；
# 排到最后可保证不影响主机上其他站点。

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAINS__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAINS__;

    ssl_certificate     __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:gift_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://127.0.0.1:9001;
        proxy_cache off;   # 宝塔 proxy.conf 在 http 层全局启用了 proxy_cache，本站点必须关掉
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
